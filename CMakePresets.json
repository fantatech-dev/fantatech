{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "msvc",
      "displayName": "Windows, Visual Studio 2026 (x64)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-ninja",
      "displayName": "Windows, MSVC + Ninja (any Visual Studio; run from a VS developer prompt)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msys2",
      "displayName": "Windows, MSYS2 UCRT64 (gcc + Ninja)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos",
      "displayName": "macOS, universal (arm64 + x86_64)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "linux",
      "displayName": "Linux (Ninja)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "msvc-ninja-debug", "configurePreset": "msvc-ninja", "configuration": "Debug" },
    { "name": "msvc-ninja-release", "configurePreset": "msvc-ninja", "configuration": "Release" },
    { "name": "msys2-debug", "configurePreset": "msys2", "configuration": "Debug" },
    { "name": "msys2-release", "configurePreset": "msys2", "configuration": "Release" },
    { "name": "macos-debug", "configurePreset": "macos", "configuration": "Debug" },
    { "name": "macos-release", "configurePreset": "macos", "configuration": "Release" },
    { "name": "linux-debug", "configurePreset": "linux", "configuration": "Debug" },
    { "name": "linux-release", "configurePreset": "linux", "configuration": "Release" }
  ]
}
